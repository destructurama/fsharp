<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Title>F# Destructuring extensions for Serilog</Title>
    <Description>Native support for destructuring F# types when logging to Serilog.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DestructuramaFSharp.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="11.0.100" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference PrivateAssets="All" Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Pack="true" PackagePath="/" Visible="false" Include="../../assets/icon.png"  />
    <None Pack="true" PackagePath="/" Visible="false" Include="../../README.md" />
  </ItemGroup>

</Project>
