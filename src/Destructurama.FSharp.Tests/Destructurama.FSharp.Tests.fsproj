<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests.fs" />
  </ItemGroup>

  <ItemGroup Label="Project under test">
    <ProjectReference Include="../Destructurama.FSharp/Destructurama.FSharp.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference PrivateAssets="all" Include="coverlet.msbuild" Version="10.0.1" />
    <PackageReference PrivateAssets="all" Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference PrivateAssets="all" Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
